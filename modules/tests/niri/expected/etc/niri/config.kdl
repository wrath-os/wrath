include "/run/system/share/niri/default-config.kdl"
input {
    focus-follows-mouse max-scroll-amount="0%"
}
layout {
    gaps 12
    shadow {
        offset x=0 y=5
        on
    }
}
output "eDP-1" {
    scale 2.0
}
prefer-no-csd
spawn-at-startup "mako"
spawn-at-startup "sh" "-c" "echo hi"
window-rule {
    focus-ring {
        off
    }
    match app-id="firefox$" title="^Picture-in-Picture$"
    match app-id="mpv"
    open-floating true
}
