#!@bash@/bin/bash
# Copies each program the current generation lists into /run/wrappers/bin, with its owner and
# mode (setuid root for sudo), and swaps the new directory in at once. The store holds no
# setuid files.
set -euo pipefail
export PATH=/system/current/sw/bin
mkdir -p /run/wrappers
next=$(mktemp -d /run/wrappers/bin.XXXXXX)
chmod 0755 "$next"
while read -r name owner group mode source; do
    if [[ ! -e $source ]]; then
        echo "wrappers: no $name, $source is missing" >&2
        continue
    fi
    cp -L "$source" "$next/$name"
    chown "$owner:$group" "$next/$name"
    chmod "$mode" "$next/$name"
done < /system/current/wrappers.list
old=$(readlink /run/wrappers/bin || true)
ln -s "${next##*/}" /run/wrappers/.next
mv -T /run/wrappers/.next /run/wrappers/bin
if [[ -n $old ]]; then
    rm -r -- "/run/wrappers/$old"
fi
