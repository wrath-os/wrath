#!@bash@/bin/bash
# Runs at the end of every boot. The first boot also applies the second system live with distro,
# and rolls back.
export PATH=/run/current-system/sw/bin SYSTEMD_PAGER= SYSTEMD_COLORS=0
say() { echo "E2E $*"; }
fetch() {
    exec 3<>"/dev/tcp/127.0.0.1/$1" || { echo "no connection on $1"; return; }
    printf 'GET / HTTP/1.0\r\nHost: native.lan\r\n\r\n' >&3
    tail -1 <&3
    exec 3>&-
}
invocation() { systemctl show -p InvocationID --value "$1"; }
port() { grep -o 'listen [0-9]*' /etc/nginx/main.conf | cut -d' ' -f2; }

boots=$(cat /var/lib/e2e-boots 2>/dev/null || echo 0)
echo $((boots + 1)) > /var/lib/e2e-boots
say "state=$(timeout 60 systemctl is-system-running --wait)"
say "failed: $(systemctl list-units --failed --no-legend --plain | tr '\n' ' ')"
say "usr: $(ls -d /usr 2>&1)"
say "firmware: $([[ -d /sys/firmware/efi ]] && echo uefi || echo none)" \
    "virtio_blk: $(grep -c '^virtio_blk ' /proc/modules) as module"
say "current=$(readlink -f /run/current-system | cut -c8-15) port=$(port)"
say "nginx=$(systemctl is-active nginx-main) nftables=$(systemctl is-active nftables)"
say "firewall: $(nft list ruleset 2>&1 | grep -c 'policy drop')"
say "page on $(port): $(fetch "$(port)")"
say "startup: $(systemd-analyze 2>&1 | head -1)"
if ((boots == 0)); then
    nginx=$(invocation nginx-main) dbus=$(invocation dbus) nftables=$(invocation nftables)
    start=$EPOCHREALTIME
    distro apply "$(cat /var/lib/e2e-next)" > /dev/null
    took=$(bc <<< "$EPOCHREALTIME - $start")
    say "switched to $(readlink -f /run/current-system | cut -c8-15) in ${took}s"
    sleep 1
    say "page on 8081: $(fetch 8081)"
    say "page on 8080 afterwards: $(fetch 8080)"
    restarted() { [[ $2 == "$(invocation "$1")" ]] && echo no || echo yes; }
    say "restarted nginx=$(restarted nginx-main "$nginx") dbus=$(restarted dbus "$dbus")" \
        "nftables=$(restarted nftables "$nftables")"
    say "failed after: $(systemctl list-units --failed --no-legend --plain | tr '\n' ' ')"
    say "history: $(distro history | tr -s ' ' | tr '\n' ';')"
    say "$(distro rollback 2>&1)"
    sleep 1
    say "page on 8080 after rolling back: $(fetch 8080)"
    distro try --for 3s "$(cat /var/lib/e2e-next)" > /dev/null
    sleep 1
    say "trying, page on 8081: $(fetch 8081)"
    sleep 6
    say "after the try, page on 8080: $(fetch 8080)"
fi
say DONE
systemctl poweroff
