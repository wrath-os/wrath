#!@bash@/bin/bash
# The first process. Brings up the disk, finds the root file system and hands over to the
# init the boot entry names. With `distro.rescue` on the command line, a failure opens a
# shell.
export PATH=@coreutils@/bin:@util-linux@/bin:@kmod@/bin:@bash@/bin
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
# switch_root takes /run along, where distro keeps what it sets up at boot.
mount -t tmpfs -o mode=0755 tmpfs /run
exec </dev/console >/dev/console 2>&1
read -r -a arguments < /proc/cmdline
fail() {
    echo "INITRD-FAILED: $*"
    if [[ " ${arguments[*]} " == *" distro.rescue "* ]]; then
        echo "INITRD rescue shell: fix it, then exit to try again"
        setsid -c bash -i
        return
    fi
    sleep 2
    echo o > /proc/sysrq-trigger
    sleep 30
}

# Drivers built into the kernel need nothing. A virtual machine's disk driver is a module.
(exec -a modprobe @kmod@/bin/kmod -d @linux@ virtio_blk 2>/dev/null) || true

for argument in "${arguments[@]}"; do
    case $argument in
        root=LABEL=*) label=${argument#root=LABEL=} ;;
        init=*) init=${argument#init=} ;;
    esac
done
[[ -n ${label:-} && -n ${init:-} ]] || fail "the command line lacks root= or init="

# USB storage can take seconds to show up.
for _ in {1..300}; do
    device=$(blkid -L "$label") && break
    sleep 0.1
done
while [[ -z ${device:-} ]]; do
    fail "no file system labelled $label"
    device=$(blkid -L "$label")
done
echo "INITRD root is $device, init $init"

mkdir -p /sysroot
until mount -o rw "$device" /sysroot; do
    fail "can't mount $device"
done
exec switch_root /sysroot "$init"
