---
source: crates/starlark/src/tests.rs
expression: describe_outputs(&evaluation)
---
packages: fprintd nftables nginx syncthing

file /etc/nftables.conf (mode 644, from firewall)
table inet filter {
  chain input {
    type filter hook input priority 0; policy drop;
    ct state established,related accept
    iif lo accept
    tcp dport 80 accept
    tcp dport 22000 accept
  }
}

file /etc/nginx/main.conf (mode 644, from nginx)
pid /run/nginx-main/nginx.pid;
error_log /var/log/nginx/main-error.log;
events {}
http {
  access_log /var/log/nginx/main-access.log;
  server {
    listen 80;
    server_name sync.box.lan;
    location / { proxy_pass http://127.0.0.1:8384; }
  }
}

file /etc/pam.d/login (mode 644, from pam)
account required pam_unix.so
auth required pam_env.so
auth sufficient pam_fprintd.so
auth sufficient pam_unix.so likeauth try_first_pass
auth required pam_deny.so
password sufficient pam_unix.so nullok yescrypt
session required pam_env.so
session required pam_unix.so
session optional pam_systemd.so

file /etc/pam.d/sudo (mode 644, from pam)
account required pam_unix.so
auth required pam_env.so
auth sufficient pam_fprintd.so
auth sufficient pam_unix.so likeauth try_first_pass
password sufficient pam_unix.so nullok yescrypt
session required pam_env.so
session required pam_unix.so
session optional pam_systemd.so

file /var/lib/syncthing/folders.json (mode 644, from syncthing)
{
  "notes": {
    "devices": [
      "desktop",
      "phone"
    ],
    "path": "/home/john/notes"
  }
}

unit fprintd.service (from fprintd)
[Unit]
Description=Fingerprint authentication daemon

[Service]
BusName=net.reactivated.Fprint
ExecStart=fprintd
Type=dbus

unit nftables.service (from firewall)
[Unit]
Before=network-pre.target
Description=nftables firewall

[Service]
ExecStart=nft -f /etc/nftables.conf
ExecStop=nft flush ruleset
RemainAfterExit=yes
Type=oneshot

[Install]
WantedBy=multi-user.target

unit nginx-main.service (from nginx)
[Unit]
After=network.target
Description=nginx (main)

[Service]
ExecReload=nginx -c /etc/nginx/main.conf -s reload
ExecStart=nginx -c /etc/nginx/main.conf -g 'daemon off;'
LogsDirectory=nginx
PrivateTmp=yes
Restart=on-failure
RuntimeDirectory=nginx-main

[Install]
WantedBy=multi-user.target

unit syncthing-main.service (from syncthing)
[Unit]
After=network.target
Description=Syncthing (main)

[Service]
ExecStart=syncthing serve --no-browser --gui-address=127.0.0.1:8384 --home=/var/lib/syncthing
Restart=on-failure
User=syncthing

[Install]
WantedBy=multi-user.target

base system (from system): { hostname = "box", timezone = "UTC" }

base users (from users): { john = { description = "John", extra_groups = ["wheel"], group = "users", home = "/home/john", packages = ["helix", "ripgrep"], shell = "/run/current-system/sw/bin/bash", system = false }, syncthing = { description = "Syncthing service", extra_groups = [], group = "users", home = "/var/lib/syncthing", packages = [], shell = "/run/current-system/sw/bin/bash", system = true } }
