unit fprintd.service (from fprintd)
[Unit]
Description=Fingerprint authentication daemon

[Service]
BusName=net.reactivated.Fprint
ExecStart=fprintd
Type=dbus

unit nftables.service (from firewall)
[Unit]
Before=network-pre.target
Description=nftables firewall

[Service]
ExecStart=nft -f /etc/nftables.conf
ExecStop=nft flush ruleset
RemainAfterExit=yes
Type=oneshot

[Install]
WantedBy=multi-user.target

unit nginx-main.service (from nginx)
[Unit]
After=network.target
Description=nginx (main)

[Service]
ExecReload=nginx -c /etc/nginx/main.conf -s reload
ExecStart=nginx -c /etc/nginx/main.conf -g 'daemon off;'
LogsDirectory=nginx
PrivateTmp=yes
Restart=on-failure
RuntimeDirectory=nginx-main

[Install]
WantedBy=multi-user.target

unit syncthing-main-init.service (from syncthing)
[Unit]
After=syncthing-main.service
Description=Syncthing (main) devices and folders
PartOf=syncthing-main.service
Requires=syncthing-main.service

[Service]
ExecStart=/bin/sh /etc/syncthing/main/apply.sh /var/lib/syncthing/.config/syncthing 127.0.0.1:8384 /etc/syncthing/main/desired.json
RemainAfterExit=yes
Type=oneshot
User=syncthing

[Install]
WantedBy=syncthing-main.service

unit syncthing-main.service (from syncthing)
[Unit]
After=network.target
Description=Syncthing (main)

[Service]
CapabilityBoundingSet=~CAP_SYS_PTRACE CAP_SYS_ADMIN CAP_SETGID CAP_SETUID CAP_SETPCAP CAP_SYS_TIME CAP_KILL
Environment=STNORESTART=yes
Environment=STNOUPGRADE=yes
ExecStart=syncthing serve --no-browser --gui-address=127.0.0.1:8384 --config=/var/lib/syncthing/.config/syncthing --data=/var/lib/syncthing/.config/syncthing
ExecStartPre=+install -dm700 -o syncthing -g syncthing /var/lib/syncthing/.config/syncthing
Group=syncthing
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
PrivateDevices=yes
PrivateMounts=yes
PrivateTmp=yes
PrivateUsers=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
Restart=on-failure
RestartForceExitStatus=3 4
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SuccessExitStatus=3 4
User=syncthing

[Install]
WantedBy=multi-user.target

